{
  "name": "fda_notebook_pipeline_event_driven",
  "description": "Imperative notebook path with smart polling. Daily check; runs full medallion only if openFDA totals changed.",
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "poll_openfda",
      "description": "Check if openFDA totals changed since last run. Sets task value `data_changed`.",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>@<domain>/fda_pharma_platform/notebooks/00b_polling_check"
      },
      "job_cluster_key": "small_cluster"
    },
    {
      "task_key": "gate_on_change",
      "description": "Skip remaining tasks if no change detected.",
      "depends_on": [{"task_key": "poll_openfda"}],
      "condition_task": {
        "op": "EQUAL_TO",
        "left": "{{tasks.poll_openfda.values.data_changed}}",
        "right": "true"
      }
    },
    {
      "task_key": "ingest_bronze",
      "depends_on": [{"task_key": "gate_on_change", "outcome": "true"}],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>@<domain>/fda_pharma_platform/notebooks/01_ingest_bronze"
      },
      "job_cluster_key": "small_cluster"
    },
    {
      "task_key": "build_silver",
      "depends_on": [{"task_key": "ingest_bronze"}],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>@<domain>/fda_pharma_platform/notebooks/02a_silver"
      },
      "job_cluster_key": "small_cluster"
    },
    {
      "task_key": "build_gold_rag",
      "depends_on": [{"task_key": "build_silver"}],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>@<domain>/fda_pharma_platform/notebooks/02b_gold_rag"
      },
      "job_cluster_key": "small_cluster"
    },
    {
      "task_key": "build_gold_analytics",
      "depends_on": [{"task_key": "build_silver"}],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>@<domain>/fda_pharma_platform/notebooks/02c_gold_analytics"
      },
      "job_cluster_key": "small_cluster"
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "small_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 1,
        "data_security_mode": "SINGLE_USER"
      }
    }
  ]
}
