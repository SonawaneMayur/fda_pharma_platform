{
  "name": "fda_dlt_gold_rag_table_triggered",
  "description": "Fires when either Silver table updates. Rebuilds RAG chunks for vector index sync.",
  "trigger": {
    "table_update": {
      "table_names": [
        "fda_rag.silver.drug_labels",
        "fda_rag.silver.adverse_events"
      ],
      "condition": "ANY_UPDATED",
      "min_time_between_triggers_seconds": 600,
      "wait_after_last_change_seconds": 60
    },
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "run_gold_rag_pipeline",
      "pipeline_task": {
        "pipeline_id": "<gold-rag-pipeline-id>",
        "full_refresh": false
      }
    }
  ]
}
