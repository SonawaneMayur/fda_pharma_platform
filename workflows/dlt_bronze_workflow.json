{
  "name": "fda_dlt_bronze_event_driven",
  "description": "Daily schedule with smart polling gate before the Bronze DLT pipeline.",
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "poll_openfda",
      "spark_python_task": {
        "python_file": "/Workspace/Users/<your-user>@<domain>/fda_pharma_platform/pipelines/bronze/_polling_check.py"
      },
      "job_cluster_key": "small_cluster"
    },
    {
      "task_key": "gate_on_change",
      "depends_on": [{"task_key": "poll_openfda"}],
      "condition_task": {
        "op": "EQUAL_TO",
        "left": "{{tasks.poll_openfda.values.data_changed}}",
        "right": "true"
      }
    },
    {
      "task_key": "run_bronze_pipeline",
      "depends_on": [{"task_key": "gate_on_change", "outcome": "true"}],
      "pipeline_task": {
        "pipeline_id": "<bronze-pipeline-id>",
        "full_refresh": false
      }
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "small_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 1,
        "data_security_mode": "SINGLE_USER"
      }
    }
  ]
}
